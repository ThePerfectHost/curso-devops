pipeline {
    agent any
    stages {
        stage("Mi primera etapa"){
            steps{
                sh "echo 'Este es mi primer pipeline desde Jenkins'"
                sh "echo 'Este es mi segundo mensaje en el pipeline desde Jenkins'"
            }
        }
        stage("Mi segunda etapa"){
            steps{
                sh "echo 'Este es mi segunda etapa del pipeline desde Jenkins'"
                sh "echo 'Este es mi segundo mensaje segunda etapa en el pipeline desde Jenkins'"
            }
        }
    }
}